# Required unless ALLOW_NO_AUTH=true for local-only testing.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-this-long-random-password
# Alternative for API clients:
# DASHBOARD_TOKEN=change-this-long-random-token

# Server and scheduler
HOST=0.0.0.0
PORT=8080
POLL_SECONDS=60
MAX_CONCURRENCY=5

# Runtime paths inside Docker
DATA_DIR=/app/data
STATE_BACKEND=sqlite
SQLITE_PATH=/app/data/cronjobs.sqlite
JOBS_DIR=/app/jobs
SCRIPTS_ROOT=/app
SECRETS_DIR=/run/secrets

# Optional notification webhook for failures/recoveries.
# NOTIFY_WEBHOOK_URL=https://example.com/internal/cron-alerts

# Only for isolated local testing. Do not use on a reachable server.
ALLOW_NO_AUTH=false
