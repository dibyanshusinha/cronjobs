{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "job.schema.json",
  "title": "Cron job definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "schedule", "type"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "schedule": { "type": "string", "minLength": 9 },
    "timezone": { "type": "string" },
    "enabled": { "type": "boolean" },
    "type": { "type": "string", "enum": ["http", "script"] },
    "retries": { "type": "integer", "minimum": 0, "maximum": 20 },
    "retry_backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 590 },
    "misfire_policy": { "type": "string", "enum": ["most_recent", "all"] },
    "misfire_cap": { "type": "integer", "minimum": 1, "maximum": 500 },
    "history_limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "history_retention_days": { "type": "integer", "minimum": 1, "maximum": 3650 },
    "failure_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auto_disable_after_consecutive_failures": { "type": "integer", "minimum": 1, "maximum": 100 },
        "initial_backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "backoff_multiplier": { "type": "number", "minimum": 1, "maximum": 10 },
        "max_backoff_seconds": { "type": "integer", "minimum": 0, "maximum": 604800 }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": { "type": "boolean" },
        "on_recovery": { "type": "boolean" }
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"] },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "expected_status": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "minItems": 1
        },
        "validate_contains": { "type": "string" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "interpreter": { "type": "string", "enum": ["bash", "python3", "node"] },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 590 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "http" } } },
      "then": { "required": ["http"] }
    },
    {
      "if": { "properties": { "type": { "const": "script" } } },
      "then": { "required": ["script"] }
    }
  ]
}
